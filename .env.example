# Required
DISCORD_TOKEN=your_bot_token_here

# Optional prefix
BOT_PREFIX=v!

# Comma-separated Discord user IDs (addmoney + dashboard admin)
# Example: BOT_OWNER_IDS=123456789012345678,987654321098765432
BOT_OWNER_IDS=

# Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Dashboard OAuth (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://YOUR_IP:PORT/callback
DASHBOARD_SECRET_KEY=change_me_to_a_long_random_string
DASHBOARD_PUBLIC_URL=http://YOUR_IP:PORT

# Port (Wispbyte usually sets SERVER_PORT automatically)
# DASHBOARD_PORT=8080

# Logging (optional)
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# LOG_TO_FILE=1           # 0 to disable log files
# LOG_MAX_BYTES=5242880   # rotate at 5 MB
# LOG_BACKUP_COUNT=5

# Sync slash cmds to one server instantly (recommended while testing)
# SYNC_GUILD_ID=123456789012345678
