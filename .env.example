# Discord bot
DISCORD_TOKEN=
BOT_PREFIX=v!
BOT_OWNER_IDS=
# Optional: sync slash cmds to one server instantly (recommended while testing)
# SYNC_GUILD_ID=123456789012345678

# Dashboard
SERVER_PORT=8080
# DASHBOARD_PUBLIC_URL=https://your-domain

# Discord OAuth (dashboard login)
CLIENT_ID=
CLIENT_SECRET=
# REDIRECT_URI=http://localhost:8080/callback

# Session secret (any long random string)
# SECRET_KEY=

# Groq AI
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Logging (optional)
# LOG_LEVEL=INFO
# LOG_TO_FILE=1
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5

# Optional: YouTube cookies file for music (when YT blocks datacenter IPs)
# YTDLP_COOKIES=cookies.txt
