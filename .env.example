# Required: Your Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Command prefix (default is v!)
BOT_PREFIX=v!

# ===== Dashboard (optional but needed for the web UI) =====
# Create these in Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_client_secret

# The URL Discord will redirect to after login.
# On Wispbyte this is usually http://YOUR_SERVER_IP:PORT/callback
# or http://localhost:8080/callback for local testing
DASHBOARD_REDIRECT_URI=http://localhost:8080/callback

# Random secret for session cookies (generate any long random string)
DASHBOARD_SECRET_KEY=change_me_to_a_long_random_string

# Port the dashboard listens on (make sure Wispbyte exposes this port)
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# Optional: public URL shown by v!dashboard / /dashboard command
DASHBOARD_PUBLIC_URL=http://YOUR_SERVER_IP:8080
